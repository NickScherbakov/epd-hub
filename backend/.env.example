# Database Configuration
DATABASE_URL=******localhost:5432/epd_hub

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Crawler Settings
CRAWLER_INTERVAL_MINUTES=60
CRAWLER_TIMEOUT_SECONDS=30

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_TELEGRAM_NOTIFICATIONS=false

# EPD-Hub knowledge base bridge (NotebookLM) — NEVER commit the real notebook URL,
# it is a secret. Set the real value only in your local/server .env (gitignored).
NOTEBOOKLM_NOTEBOOK_URL=
NOTEBOOKLM_STATE_DIR=/app/data/notebooklm_state
ASK_CACHE_TTL_SECONDS=3600

# Application Settings
DEBUG=true
LOG_LEVEL=INFO
